# Supabase project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret used by the (future) iCal subscription endpoint
CALENDAR_SUBSCRIPTION_TOKEN=
