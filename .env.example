# Copy this file to .env.local and fill in the two values from Supabase:
#   Supabase Dashboard → Project Settings → API
#
# Both are safe to send to the browser. Security is enforced by Row-Level
# Security inside the database, not by keeping these secret.
#
# Note: this app deliberately does NOT use the Supabase service-role key.
# That key ignores Row-Level Security, so leaving it out means a bug can
# never expose one family's data to another.

# Project URL, looks like https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key (a long string starting with "eyJ" or "sb_publishable_")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
