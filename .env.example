# Copy this file to .env.local and fill in the two values from Supabase:
#   Supabase Dashboard → Project Settings → API
#
# Both are safe to send to the browser. Security is enforced by Row-Level
# Security inside the database, not by keeping these secret.
#
# Note: this app deliberately does NOT use the Supabase service-role key.
# That key ignores Row-Level Security, so leaving it out means a bug can
# never expose one family's data to another.

# Project URL, looks like https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key (a long string starting with "eyJ" or "sb_publishable_")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Push notifications (Phase P4) ──────────────────────────────────────────
# Generate these once with:  node scripts/generate-vapid-keys.mjs
# Leave them blank and the app simply hides the "Turn on reminders" card.

# Sent to phones so they can verify pushes really came from this app. Public.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# SECRET. Signs each push. Never commit this or paste it into a chat.
VAPID_PRIVATE_KEY=

# A contact address push services can use to reach you, e.g. mailto:you@example.com
VAPID_SUBJECT=
